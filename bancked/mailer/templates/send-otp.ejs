<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password OTP Email</title>
  <style>
    /* Reset for email clients */
    body,
    table,
    td,
    p {
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #000000;
      font-family: Arial, sans-serif;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
    }

    .logo td {
      padding: 10px;
    }

    .logo img {
      max-height: 60px;
      width: auto;
    }

    .email-header {
      background: #1a1a1a;
      padding: 20px;
      text-align: center;
    }

    .email-header h1 {
      color: #ffffff;
      font-size: 22px;
      margin: 0;
    }

    .email-body {
      padding: 20px;
      color: #333333;
      font-size: 16px;
      line-height: 1.6;
    }

    .otp-box {
      display: inline-block;
      margin: 15px 0;
      padding: 12px 20px;
      background: #f3f3f3;
      border-radius: 6px;
      font-size: 20px;
      font-weight: bold;
      letter-spacing: 2px;
      color: #000000;
    }

    .email-footer {
      background: #f9f9f9;
      text-align: center;
      padding: 15px;
      font-size: 14px;
      color: #666666;
    }

    /* Responsive */
    @media only screen and (max-width: 600px) {
      .logo td {
        display: block;
        text-align: center !important;
        width: 100% !important;
      }

      .email-header h1 {
        font-size: 18px;
      }

      .email-body {
        font-size: 15px;
        padding: 15px;
      }
    }
  </style>
</head>

<body>
  <!-- Email Wrapper -->
  <table class="email-container" role="presentation" cellspacing="0" cellpadding="0" width="100%">
    <!-- Header Logos -->
    <tr>
      <td class="logo">
        <table width="100%" cellspacing="0" cellpadding="0">
          <tr>
            <td align="left" style="width: 33%">
              <a href="/" target="_blank">
                <img src="https://www.nfa.futures.org/cms/images/logo.png" alt="Logo" /></a>
            </td>
            <td align="center" style="width: 33%">
              <a href="https://www.mib.gov.in/" target="_blank">
                <img src="https://www.nfa.futures.org/cms/images/logo.png" alt="Logo" /></a>
            </td>
            <td align="right" style="width: 33%">
              <a href="https://www.nfdcindia.com/" target="_blank">
                <img src="https://www.nfa.futures.org/cms/images/logo.png" alt="Logo" /></a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Header Title -->
    <tr>
      <td class="email-header">
        <h1>Reset Your Password - NFA</h1>
      </td>
    </tr>

    <!-- Body -->
    <tr>
      <td class="email-body">
        <p>Dear <strong>
            <%= clientName %>
          </strong>,</p>
        <p>We received a request to reset your NFA account password.</p>
        <p><b>Use the One-Time Password (OTP) below to proceed:</b></p>

        <!-- OTP Box -->
        <div class="otp-box">
          <%= otp %>
        </div>

        <p>This OTP is valid for the next 10 minutes.</p>
        <p>
          If you didn't request a password reset, please ignore this message.
        </p>

        <p>Warm Regards,<br /><strong>Team NFA</strong></p>
      </td>
    </tr>

    <!-- Footer -->
    <tr>
      <td class="email-footer">
        <p>&copy; 2025 NFA All Rights Reserved</p>
      </td>
    </tr>
  </table>
</body>

</html>